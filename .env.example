# --- LLM (Gemini) ---
# "api_key" uses GEMINI_API_KEY (Google AI Studio). "vertex" uses Application Default Credentials.
GEMINI_AUTH=api_key
GEMINI_API_KEY=
# Fast model for routing and SQL, stronger model for report writing. Check AI Studio for current names.
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=

# --- Data backend ---
# "duckdb" = local mock data (default), "bigquery" = real thelook_ecommerce dataset
DATA_BACKEND=duckdb
DUCKDB_PATH=data/mock.duckdb
GCP_PROJECT_ID=
BQ_DATASET=bigquery-public-data.thelook_ecommerce
BQ_MAX_BYTES_BILLED=1000000000

# --- Users ---
# Mock user profiles (who may analyse which products). Defaults to config/users.<DATA_BACKEND>.json
# PROFILES_PATH=

# --- Agent limits ---
MAX_SQL_RETRIES=2
MAX_ROWS=500
TURN_TOKEN_BUDGET=60000

# --- Local state ---
REPORTS_DB_PATH=data/reports.sqlite
TRACE_DIR=logs

# Copy to .env and fill in. Only GEMINI_API_KEY is needed for a local run on mock data.

# --- Model (Gemini) ---
# "api_key" uses GEMINI_API_KEY from Google AI Studio. "vertex" uses Application Default
# Credentials with GCP_PROJECT_ID and GCP_LOCATION (the production setup).
GEMINI_AUTH=api_key
GEMINI_API_KEY=
# The defaults work on the free tier. With a paid key or Vertex AI, gemini-3.8-flash gives better
# answers; on the free tier it is limited to 20 requests a day (checked 2026-10-04).
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GCP_LOCATION=global

# --- Data ---
# "duckdb" = local mock data (default). "bigquery" = the real thelook_ecommerce dataset.
DATA_BACKEND=duckdb
# Needed for DATA_BACKEND=bigquery (the project that is billed for queries) and for GEMINI_AUTH=vertex
GCP_PROJECT_ID=
# BQ_DATASET=bigquery-public-data.thelook_ecommerce
# BQ_MAX_BYTES_BILLED=1000000000
# DUCKDB_PATH=data/mock.duckdb

# --- Limits per question ---
# MAX_SQL_RETRIES=2
# MAX_ROWS=500
# ROWS_TO_MODEL=50
# MAX_LLM_CALLS=8
# TURN_TOKEN_BUDGET=60000

# --- Local state and editable content ---
# REPORTS_DB_PATH=data/reports.sqlite
# TRACE_DIR=logs
# PERSONA_PATH=config/persona.md
# GOLDEN_DIR=golden_bucket
# PROFILES_PATH=            (defaults to config/users.<DATA_BACKEND>.json)
